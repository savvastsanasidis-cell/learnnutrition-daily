{
  "_comment": "Ρυθμίσεις για το Daily Research Brief του learnnutrition.gr. Διαβάζεται σε κάθε session ώστε η μεθοδολογία να είναι σταθερή. Κανόνας: ΜΟΝΟ ανθρώπινες μελέτες (αποκλεισμός μελετών σε ζώα/in vitro), αληθινά PMID από PubMed, de-duplication μέσω seen_pmids.json.",
  "rules": {
    "humans_only": true,
    "exclude_publication_or_subjects": ["Animals", "Mice", "Rats", "in vitro", "cell line"],
    "prefer_publication_types": ["Randomized Controlled Trial", "Clinical Trial", "Meta-Analysis", "Systematic Review", "Observational Study", "Cohort"],
    "default_reldate_days": 45,
    "studies_per_brief": "6-10",
    "dedup_file": "seen_pmids.json"
  },
  "topics": {
